# ============================================================
# CLEANOVA AI MODULE - Mẫu biến môi trường
# ============================================================
# HƯỚNG DẪN: copy file này thành `.env` rồi chỉnh theo máy của bạn.
#   Windows : copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# File `.env` sẽ KHÔNG được đẩy lên git (đã có trong .gitignore)
# để tránh lộ cấu hình / API key.
# ============================================================

# Cổng chạy module AI (tách biệt với backend chính ở cổng 5000)
PORT=5100

# HOST=0.0.0.0 cho phép máy khác trong cùng WiFi/LAN truy cập
HOST=0.0.0.0

# ------------------------------------------------------------
# Nguồn phân tích AI
# ANALYZER=builtin  -> dùng engine heuristic có sẵn trong repo
#                      (chạy được ngay, không cần GPU/API key)
# ANALYZER=external -> gọi một HTTP service AI bên ngoài (tùy chọn)
# ------------------------------------------------------------
ANALYZER=builtin

# Chỉ dùng khi ANALYZER=external
# AI_SERVICE_URL=http://localhost:9000/predict
# AI_SERVICE_KEY=

# Giới hạn dung lượng ảnh tải lên (bytes). Mặc định 10MB
MAX_UPLOAD_BYTES=10485760
